# ── Client (safe to expose — bundled into the frontend) ───────────────────
# These are PUBLIC values. Never put secrets here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# Stripe Price IDs for each paid plan (public — safe to expose). Create the
# products/prices in Stripe, then paste the price IDs here and set the matching
# STRIPE_PRICE_DEVELOPER / STRIPE_PRICE_ENTERPRISE in Edge Function secrets.
VITE_STRIPE_PRICE_DEVELOPER=price_xxx
VITE_STRIPE_PRICE_ENTERPRISE=price_xxx
VITE_GITHUB_CLIENT_ID=your-github-oauth-client-id

# ── Server ONLY — set these in Supabase Edge Function secrets, NOT here, NOT
#    in Vercel client env, NOT prefixed with VITE_. Listed for reference. ────
# SUPABASE_SERVICE_ROLE_KEY=...        # full DB admin — bypasses RLS
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# GITHUB_CLIENT_SECRET=...
# GITHUB_WEBHOOK_SECRET=...
# ENCRYPTION_KEY=...                   # for encrypting stored integration tokens
# APP_URL=https://app.lythouse.ai
